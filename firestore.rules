rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isSecretary() {
      return isAuthenticated()
        && currentUser().role == "secretaria";
    }

    function isDentist() {
      return isAuthenticated()
        && currentUser().role == "dentista";
    }

    function isStaff() {
      return isSecretary() || isDentist();
    }

    function validRole(role) {
      return role == "secretaria" || role == "dentista";
    }

    match /users/{userId} {
      allow read: if isAuthenticated()
        && request.auth.uid == userId;

      allow create, update, delete: if false;
    }

    match /patients/{patientId} {
      allow read: if isStaff();

      allow create: if isSecretary()
        && request.resource.data.keys().hasOnly([
          "name",
          "phone",
          "email",
          "lastCleaningDate",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.phone is string;

      allow update: if isSecretary()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "name",
            "phone",
            "email",
            "lastCleaningDate",
            "updatedAt"
          ]);

      allow delete: if false;
    }

    match /patients/{patientId}/clinicalNotes/{noteId} {
      allow read: if isDentist();

      allow create: if isDentist()
        && request.resource.data.dentistId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "dentistId",
          "procedure",
          "notes",
          "createdAt"
        ])
        && request.resource.data.procedure is string
        && request.resource.data.notes is string;

      allow update, delete: if isDentist()
        && resource.data.dentistId == request.auth.uid;
    }

    match /appointments/{appointmentId} {
      allow read: if isSecretary()
        || (
          isDentist()
          && resource.data.dentistId == request.auth.uid
        );

      allow create: if isSecretary()
        || (
          isDentist()
          && request.resource.data.dentistId == request.auth.uid
        );

      allow update: if isSecretary()
        || (
          isDentist()
          && resource.data.dentistId == request.auth.uid
          && request.resource.data.dentistId == request.auth.uid
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "status",
              "notes",
              "updatedAt"
            ])
        );

      allow delete: if false;
    }

    match /blockedSlots/{slotId} {
      allow read: if isSecretary()
        || (
          isDentist()
          && resource.data.dentistId == request.auth.uid
        );

      allow create: if isDentist()
        && request.resource.data.dentistId == request.auth.uid;

      allow update, delete: if isDentist()
        && resource.data.dentistId == request.auth.uid;
    }
  }
}
